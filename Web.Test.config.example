<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="BMSConnectionString" connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=BMS_TEST;Persist Security Info=True;User ID=sa;Password=YOUR_PASSWORD;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
    <add name="LoginConnectionString" connectionString="Server=YOUR_SQL_SERVER;Database=OneSystem;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="EPPlus:ExcelPackage.License" value="NonCommercialOrganization:KingPower" />
    <add key="LDAP_SERVER" value="kingpower.com" />
    <add key="LDAP_SEARCH_ROOT" value="LDAP://kingpower.com/ou=King Power Group,dc=kingpower,dc=com" />
    <add key="LDAP_BIND_USER" value="YOUR_AD_SERVICE_ACCOUNT" />
    <add key="LDAP_BIND_PASSWORD" value="YOUR_AD_SERVICE_PASSWORD" />
    <add key="SAPAPI_BASEURL" value="http://127.0.0.1:18080" />
    <add key="SAPAPI_USERNAME" value="mock-user" />
    <add key="SAPAPI_PASSWORD" value="mock-password" />
  </appSettings>
  <!-- 25 MB request envelope. The Draft OTB application limit remains 20 MB,
       leaving room for multipart/form-data headers and other request fields. -->
  <system.web>
    <httpRuntime targetFramework="4.7.2" maxRequestLength="25600" executionTimeout="3600" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
